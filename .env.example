# Скопируйте этот файл как .env и впишите свои значения.
# Команда в PowerShell:  Copy-Item .env.example .env
#
# ВНИМАНИЕ: файл .env содержит секреты и НИКОГДА не должен попадать в git.
# Он уже добавлен в .gitignore.

# Ключ авторизации GigaChat API.
# Где взять: личный кабинет Studio -> проект GigaChat API -> "Настройки API" -> "Получить ключ".
# Вставьте сюда значение поля "Authorization Key" (это готовая строка в Base64).
GIGACHAT_API_KEY=

# Тариф GigaChat API (выберите один):
#   GIGACHAT_API_PERS - бесплатно, для физических лиц (значение по умолчанию)
#   GIGACHAT_API_CORP - для ИП и юридических лиц с оплатой по факту (pay-as-you-go)
#   GIGACHAT_API_B2B  - для ИП и юридических лиц с предоплаченными пакетами токенов
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat, которая будет анализировать заявку.
#   GigaChat-2-Max - лучше всего следует сложным инструкциям (рекомендуется)
#   GigaChat-2-Pro - чуть быстрее и дешевле
#   GigaChat-2     - самая быстрая и дешёвая
GIGACHAT_MODEL=GigaChat-2-Max

# Проверять ли сертификат сервера GigaChat.
#   true  (по умолчанию) - проверка включена, используется сертификат УЦ Минцифры
#                           из папки certs (файл russian_trusted_root_ca.pem)
#   false - проверка отключена (так же работает официальный SDK GigaChat),
#           менее безопасно, используйте только если сертификат не подходит
GIGACHAT_VERIFY_SSL=true

# Битрикс24 - входящий вебхук
# Формат: https://your-portal.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/
B24_WEBHOOK_URL=
# Ответственный по умолчанию (ID пользователя Битрикс24). Необязательно
B24_ASSIGNED_BY_ID=